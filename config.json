{
    "paths": {
        "project_remark_and_log_file_name": "project_remark.txt",
        "github_current_state": "github_current_state/",
        "github_token_file": "api_keys/github.txt",
        "weekly_report": "reports/weekly_report/",
        "monthly_report": "reports/monthly_report/",
        "project_report": "reports/"
    },

    "github_repos": [
        "https://github.com/wolodkin/de_nbi",
        "https://github.com/Senckenberg-DCBiodivIT/BITS"
    ],

    "ai:config": {
        "active_model_name": "nvidia/nemotron-3-super-120b-a12b:free_openrouter",
        "active_model_name_comment": "Model used for report generation (Phases 2-4).",

        "ai_debug": {
            "ai_debug_comment": "Store raw AI responses under ai_debug/ when enabled.",
            "store_ai_responses": true,
            "store_ai_responses_path": "ai_debug/"
        },

        "ai_model_config": {
            "nvidia/nemotron-3-super-120b-a12b:free_openrouter": {
                "comment": "OpenRouter-compatible endpoint; reports use JSON in code, rendered to Markdown.",
                "url": "https://openrouter.ai/api/v1",
                "model": "nvidia/nemotron-3-super-120b-a12b:free",
                "num_ctx": 250000,
                "temperature": 0.3,
                "timeout": 1000,
                "stream": false,
                "api_key_file": "api_keys/openrouter.txt"
            }
        }
    },

    "prompts_and_templates": {
        "comment": "Prompts request JSON matching schemas in code; templates are Markdown render targets.",
        "weekly_report": {
            "prompt": "prompts/weekly_report.txt",
            "template": "templates/weekly_report.txt"
        },
        "monthly_report": {
            "prompt": "prompts/monthly_report.txt",
            "template": "templates/monthly_report.txt"
        },
        "project_report": {
            "prompt": "prompts/project_report.txt",
            "template": "templates/project_report.txt"
        }
    }
}
